# ===== 唯一必填 =====
# 机器人 token，向 @BotFather 申请（/newbot）
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ===== 可选（都有默认值，无需配置也能跑）=====
# 数据目录（默认 ./data）
DATA_DIR=./data
# 网页 JS 验证的 HTTP 端口（默认 8080）
WEB_PORT=8080
# Telegram API 代理：http://host:port / https:// / socks5://（本次测试走本机 10808）
TG_PROXY=http://127.0.0.1:10808
# 网页验证的公网地址，也可启动后用 /config publicUrl 设置（数据库优先）
PUBLIC_URL=
# 试运行：true 时只记录不真删/禁言（联调用）
DRY_RUN=false
# 日志级别 debug|info|warn|error
LOG_LEVEL=info
